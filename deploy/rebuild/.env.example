# Copy to deploy/rebuild/.env. Never commit the filled .env.
# OpenAI-compatible model; the local launcher reads only the named connection fields.
LLM_API_KEY=
LLM_BASE_URL=https://api.example.com/v1
LLM_MODEL_ID=
NEXUS_OWNER_EMAIL=

# Optional SMTP for email verification; credentials stay on the server.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# PostgreSQL binaries are selected through the PowerShell process environment:
# $env:NF_POSTGRES_BIN = 'C:\path\to\PostgreSQL\bin'
# Optional alternative model file: $env:NF_MODEL_ENV_FILE = 'C:\private\model.env'

# ============================================
# 后端环境变量示例 - 复制为 .env 并按需修改
# ============================================

# 服务监听端口
PORT=30050

# 运行模式: development | production
NODE_ENV=production

# ============================================
# 数据库 (PostgreSQL)
# ============================================
# 本地开发可用: postgresql://postgres:postgres@localhost:5432/nexus
# 生产环境（Docker Compose 内部网络）会用 service 名 postgres 作为 host
DATABASE_URL=postgresql://nexus:nexus_password_change_me@postgres:5432/nexus

# ============================================
# JWT 认证
# ============================================
# 生产环境务必改成随机长字符串！
# 生成方式: openssl rand -base64 64
JWT_SECRET=please-change-this-to-a-random-string-in-production

# 邮箱认证必须使用独立密钥，至少 32 字符；旧 JWT_SECRET 不得复用
AUTH_JWT_SECRET=
AUTH_EMAIL_CODE_PEPPER=
AUTH_ALLOWED_ORIGINS=https://your-domain.example
REDIS_URL=redis://redis:6379
TRUSTED_PROXY_CIDRS=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_ALLOW_INSECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TIMEOUT_MS=10000

# 持久化 Run 使用独立 noeviction 队列 Redis，不能复用认证/缓存 Redis。
WORKFLOW_REDIS_URL=redis://queue-redis:6379
WORKFLOW_QUEUE_NAME=nf-runs
WORKFLOW_QUEUE_PREFIX=nf-runs
RUN_WORKER_CONCURRENCY=8
RUN_LEASE_MS=15000
RUN_RECOVERY_INTERVAL_MS=1000
WORKFLOW_HTTP_ALLOWED_HOSTS=

# 默认关闭。仅受信 Worker 可访问隔离 Docker daemon；API 不应挂载 Docker socket。
# 启用前必须验收固定摘要镜像，API/Worker 开关一致；不自动 pull。
WORKFLOW_JS_ENABLED=false
WORKFLOW_JS_IMAGE=
# P01 必须注入独立 AES-256 密钥；值由 secret manager 提供，不提交真实密钥。
# JSON object: key-id -> 32-byte canonical base64. 保留旧 key 可解密旧密文，active 选择新写 key。
CONNECTION_ENCRYPTION_KEYS=
CONNECTION_ACTIVE_KEY_ID=
# 精确批准 HTTPS 域名；默认空意味着拒绝所有用户/系统模型和旧 HTTP 节点出站。
OUTBOUND_ALLOWED_HOSTS=

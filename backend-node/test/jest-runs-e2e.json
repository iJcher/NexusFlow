{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testRegex": "test/runs/.*\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", { "tsconfig": "tsconfig.json" }]
  },
  "testEnvironment": "node",
  "testTimeout": 60000,
  "maxWorkers": 1,
  "reporters": [
    "default",
    [
      "jest-junit",
      {
        "outputDirectory": "../artifacts/acceptance/P02/integration",
        "outputName": "junit.xml"
      }
    ]
  ]
}

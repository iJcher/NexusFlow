{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testRegex": "test/auth/.*\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", { "tsconfig": "tsconfig.json" }]
  },
  "testEnvironment": "node",
  "testTimeout": 30000,
  "maxWorkers": 1,
  "reporters": ["default", ["jest-junit", { "outputName": "auth-junit.xml" }]]
}

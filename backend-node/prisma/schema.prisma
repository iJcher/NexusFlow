generator client {
  provider        = "prisma-client-js"
  // 启用 Postgres 扩展支持，用于声明 pgvector
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // pgvector 扩展：用于知识库 chunk 的向量检索（直接在 PG 内算 cosine，
  // 替代「全表 findMany 进 Node 算」的方案，从根本上解决 RAG 内存爆炸问题）
  extensions = [vector]
}

model FlowEntity {
  id               BigInt            @id
  ownerUserId      BigInt?
  displayName      String            @default("")
  flowType         Int               @default(0)
  description      String            @default("")
  configInfoForRun String?
  configInfoForWeb String?
  lastModified     DateTime?         @updatedAt
  lastModifyBy     String?
  versions         WorkflowVersion[]

  @@index([ownerUserId])
  @@index([flowType])
  @@map("FlowEntity")
}

model FlowLLMProviderEntity {
  id           BigInt  @id
  ownerUserId  BigInt?
  platformName String
  llmNames     String
  llmAPIUrl    String
  llmAPIKey    String

  @@index([ownerUserId])
  @@map("FlowLLMProviderEntity")
}

model FlowChatConversationEntity {
  conversationId   String   @id
  ownerUserId      BigInt?
  user             String
  flowId           BigInt
  title            String   @default("")
  isTop            Boolean  @default(false)
  messageCount     Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  variables        String?

  @@unique([conversationId, user])
  @@index([ownerUserId, flowId, updatedAt])
  @@map("FlowChatConversationEntity")
}

model FlowChatMessageEntity {
  id               BigInt   @id
  ownerUserId      BigInt?
  user             String
  flowId           BigInt
  conversationId   String
  flowInstanceId   BigInt
  question         String   @default("")
  answer           String   @default("")
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  createdAt        DateTime @default(now())
  files            String?

  @@index([ownerUserId, flowId, conversationId, createdAt])
  @@index([user, conversationId, createdAt])
  @@map("FlowChatMessageEntity")
}

model UserEntity {
  id                BigInt        @id
  phoneNumber       String?       @unique
  passwordHash      String?
  passwordSalt      String?
  email             String?       @unique
  emailVerifiedAt   DateTime?
  authSessions      AuthSession[]
  nickName          String
  lastLoginIp       String        @default("")
  lastLoginTime     DateTime      @default(now())
  registerTime      DateTime      @default(now())
  source            String?
  isDeleted         Boolean       @default(false)
  isEnable          Boolean?      @default(true)
  lockoutEndDateUtc DateTime?
  lockoutEnabled    Boolean       @default(false)
  accessFailedCount Int?          @default(0)
  role              Int           @default(1)

  @@map("UserEntity")
}

model Workspace {
  id          String            @id @default(uuid()) @db.Uuid
  ownerUserId BigInt            @unique
  name        String
  createdAt   DateTime          @default(now())
  members     WorkspaceMember[]
  versions    WorkflowVersion[]
  runs        FlowRun[]
  invitations WorkspaceInvitation[]
  audit       WorkspaceAudit[]
}

model WorkspaceMember {
  workspaceId String    @db.Uuid
  userId      BigInt
  role        String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@id([workspaceId, userId])
  @@index([userId])
}

model WorkspaceInvitation {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  email       String
  role        String
  invitedBy   BigInt
  expiresAt   DateTime
  acceptedAt  DateTime?
  acceptedBy  BigInt?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@index([workspaceId, createdAt])
}

model WorkspaceAudit {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  actorUserId BigInt
  action      String
  targetId    String
  role        String?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@index([workspaceId, createdAt])
}

model WorkflowVersion {
  id            String     @id @default(uuid()) @db.Uuid
  workspaceId   String     @db.Uuid
  sourceFlowId  BigInt
  number        Int
  schemaVersion Int        @default(1)
  graph         Json
  hash          String
  publishedBy   BigInt
  createdAt     DateTime   @default(now())
  disabledAt    DateTime?
  workspace     Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  sourceFlow    FlowEntity @relation(fields: [sourceFlowId], references: [id], onDelete: Restrict)
  runs          FlowRun[]

  @@unique([sourceFlowId, number])
  @@index([workspaceId, createdAt])
}

model FlowRun {
  id                String              @id @default(uuid()) @db.Uuid
  workspaceId       String              @db.Uuid
  versionId         String              @db.Uuid
  initiatorUserId   BigInt
  input             Json
  status            String              @default("queued")
  cancelRequestedAt DateTime?
  highWaterSeq      Int                 @default(0)
  errorCode         String?
  createdAt         DateTime            @default(now())
  startedAt         DateTime?
  finishedAt        DateTime?
  workspace         Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  version           WorkflowVersion     @relation(fields: [versionId], references: [id], onDelete: Restrict)
  nodes             NodeRun[]
  edges             RunEdge[]
  events            RunEvent[]
  outbox            RunOutbox[]
  operations        ExternalOperation[]

  @@index([workspaceId, createdAt])
  @@index([status, createdAt])
}

model NodeRun {
  id                 String              @id @default(uuid()) @db.Uuid
  runId              String              @db.Uuid
  nodeId             String
  parentNodeId       String?
  itemId             String?
  itemIndex          Int?
  kind               String
  status             String              @default("pending")
  resolvedInputs     Json?
  output             Json?
  errorCode          String?
  attemptCount       Int                 @default(0)
  fencing            Int                 @default(0)
  leaseUntil         DateTime?
  workerId           String?
  retryAt            DateTime?
  dispatchGeneration Int                 @default(0)
  lastDispatchAt     DateTime?
  createdAt          DateTime            @default(now())
  startedAt          DateTime?
  finishedAt         DateTime?
  run                FlowRun             @relation(fields: [runId], references: [id], onDelete: Restrict)
  attempts           NodeAttempt[]
  operations         ExternalOperation[]

  @@unique([runId, nodeId])
  @@index([runId, parentNodeId, status])
  @@index([status, leaseUntil])
  @@index([status, retryAt])
}

model NodeAttempt {
  id         String    @id @default(uuid()) @db.Uuid
  nodeRunId  String    @db.Uuid
  number     Int
  fencing    Int
  workerId   String
  status     String
  input      Json
  output     Json?
  errorCode  String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  nodeRun    NodeRun   @relation(fields: [nodeRunId], references: [id], onDelete: Restrict)

  @@unique([nodeRunId, number])
}

model RunEdge {
  runId      String  @db.Uuid
  edgeId     String
  fromNodeId String
  toNodeId   String
  status     String  @default("unresolved")
  run        FlowRun @relation(fields: [runId], references: [id], onDelete: Restrict)

  @@id([runId, edgeId])
}

model RunEvent {
  runId         String   @db.Uuid
  seq           Int
  type          String
  schemaVersion Int      @default(1)
  nodeId        String?
  attemptId     String?  @db.Uuid
  payload       Json
  createdAt     DateTime @default(now())
  run           FlowRun  @relation(fields: [runId], references: [id], onDelete: Restrict)

  @@id([runId, seq])
}

model RunOutbox {
  id            String    @id @default(uuid()) @db.Uuid
  runId         String    @db.Uuid
  nodeId        String
  generation    Int
  publishedAt   DateTime?
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  createdAt     DateTime  @default(now())
  run           FlowRun   @relation(fields: [runId], references: [id], onDelete: Restrict)

  @@unique([runId, nodeId, generation])
  @@index([publishedAt, nextAttemptAt])
}

model ExternalOperation {
  id               String   @id @default(uuid()) @db.Uuid
  runId            String   @db.Uuid
  nodeRunId        String   @db.Uuid
  operationKey     String   @unique
  requestHash      String
  target           String
  status           String
  result           Json?
  errorCode        String?
  resolutionReason String?
  resolvedBy       BigInt?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  run              FlowRun  @relation(fields: [runId], references: [id], onDelete: Restrict)
  nodeRun          NodeRun  @relation(fields: [nodeRunId], references: [id], onDelete: Restrict)

  @@index([runId, status])
}

// Legacy users retain their ids/ownership. Email identities are never inferred.
model EmailLoginChallenge {
  id         String    @id @db.Uuid
  email      String
  purpose    String    @default("login")
  codeHash   String
  sendState  String    @default("pending")
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
  @@index([expiresAt])
}

model AuthEmailState {
  email              String   @id
  activeChallengeId  String?  @db.Uuid
  pendingChallengeId String?  @db.Uuid
  lastRequestedAt    DateTime
}

model AuthSession {
  id           String     @id @db.Uuid
  userId       BigInt
  user         UserEntity @relation(fields: [userId], references: [id], onDelete: Restrict)
  familyId     String     @db.Uuid
  tokenHash    String     @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?    @db.Uuid
  createdAt    DateTime   @default(now())

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
}

// ==================== 组件模板库 ====================

model FlowTemplateEntity {
  id               BigInt   @id
  ownerUserId      BigInt?
  name             String
  description      String   @default("")
  flowType         Int      @default(0)
  category         String   @default("custom")
  tags             String   @default("[]")
  configInfoForRun String?
  configInfoForWeb String?
  isOfficial       Boolean  @default(false)
  createdBy        String   @default("")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  @@index([ownerUserId])
  @@index([flowType])
  @@index([category])
  @@index([isOfficial])
  @@map("FlowTemplateEntity")
}

// ==================== RAG 知识库 ====================

model KnowledgeBaseEntity {
  id             BigInt   @id
  ownerUserId    BigInt?
  name           String
  description    String   @default("")
  createdBy      String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
  docCount       Int      @default(0)
  chunkCount     Int      @default(0)
  status         String   @default("active")
  embeddingModel String   @default("")
  chunkSize      Int      @default(500)
  chunkOverlap   Int      @default(50)
  chunkStrategy  String   @default("paragraph")

  documents KnowledgeDocumentEntity[]

  @@index([ownerUserId])
  @@index([createdBy])
  @@map("KnowledgeBaseEntity")
}

model KnowledgeDocumentEntity {
  id              BigInt   @id
  knowledgeBaseId BigInt
  fileName        String
  fileSize        Int      @default(0)
  fileType        String   @default("")
  content         String   @default("")
  chunkCount      Int      @default(0)
  status          String   @default("pending")
  errorMsg        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  knowledgeBase KnowledgeBaseEntity       @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  chunks        KnowledgeDocChunkEntity[]

  @@index([knowledgeBaseId])
  @@map("KnowledgeDocumentEntity")
}

model KnowledgeDocChunkEntity {
  id           BigInt                       @id
  documentId   BigInt
  chunkIndex   Int                          @default(0)
  content      String                       @default("")
  // 旧字段：JSON 字符串形式的 embedding，保留作为兜底/回滚通道
  embedding    String                       @default("[]")
  // 新字段：pgvector 原生向量类型，1024 维（text-embedding-v4 默认维度）
  // Prisma 不支持 vector 原生 DSL，用 Unsupported 声明
  // 实际相似度查询走 $queryRawUnsafe + SQL operator <=> （cosine distance）
  embeddingVec Unsupported("vector(1024)")?
  tokenCount   Int                          @default(0)

  document KnowledgeDocumentEntity @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("KnowledgeDocChunkEntity")
}

model SkillEntity {
  id               BigInt   @id
  ownerUserId      BigInt
  flowId           BigInt
  name             String
  description      String   @default("")
  version          Int      @default(1)
  inputSchema      String   @default("{}")
  outputSchema     String   @default("{}")
  workflowSnapshot String
  filesJson        String   @default("{}")
  generationPrompt String   @default("")
  modelName        String   @default("")
  status           String   @default("generated")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  @@index([ownerUserId])
  @@index([flowId])
  @@map("SkillEntity")
}

model McpServerEntity {
  id          BigInt    @id
  ownerUserId BigInt
  name        String
  transport   String    @default("sse")
  endpoint    String    @default("")
  command     String    @default("")
  args        String    @default("[]")
  env         String    @default("{}")
  headers     String    @default("{}")
  toolsJson   String    @default("[]")
  lastSyncAt  DateTime?
  status      String    @default("active")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@index([ownerUserId])
  @@map("McpServerEntity")
}

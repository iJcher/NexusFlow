# ============================================
# Docker Compose 环境变量
# 复制本文件为 .env 并修改密码、密钥
# ============================================

# PostgreSQL
POSTGRES_USER=nexus
POSTGRES_PASSWORD=请改成你自己的强密码
POSTGRES_DB=nexus

# JWT 签名密钥 - 必须改成随机长字符串！
# 生成方式: openssl rand -base64 64
JWT_SECRET=请改成随机64位字符串

# P00 邮箱登录：必须独立生成两份不同的随机密钥；不能复用旧 JWT_SECRET
# 所有旧 JWT / 旧手机号密码登录入口失效；不会给历史账户自动绑定邮箱
AUTH_JWT_SECRET=
AUTH_EMAIL_CODE_PEPPER=
# P01 独立连接秘密加密 keyring；从 secret manager 注入，禁止复用 JWT key。
CONNECTION_ENCRYPTION_KEYS=
CONNECTION_ACTIVE_KEY_ID=
# 精确批准的 HTTPS/443 出站域名；空表示全部拒绝。
OUTBOUND_ALLOWED_HOSTS=
# 外部浏览器实际访问的 HTTPS origin，无路径；多个以逗号分隔，禁止通配符
AUTH_ALLOWED_ORIGINS=https://your-domain.example
AUTH_EMAIL_CODE_TTL_SECONDS=600
AUTH_EMAIL_CODE_COOLDOWN_SECONDS=60
AUTH_EMAIL_CODE_MAX_ATTEMPTS=5
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=604800
# 留空不信任 X-Forwarded-For。仅填写实际可信反代 CIDR，禁止宽泛信任互联网
TRUSTED_PROXY_CIDRS=
# 生产邮件：587 STARTTLS / 465 TLS；凭证放本地 .env，不能提交
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_ALLOW_INSECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TIMEOUT_MS=10000

# ============================================
# Skill 生成默认大模型（系统兜底，所有用户共享）
# 当前接的是 dogapi 中转：https://www.dogapi.cc
# 模型清单获取方式：
#   curl -H "Authorization: Bearer $TOKEN" https://www.dogapi.cc/v1/models
# ⚠️ MODEL_NAME 必须是 token 实际有权访问的模型，否则会 403
# ============================================
SKILL_DEFAULT_API_URL=https://www.dogapi.cc
SKILL_DEFAULT_API_KEY=请填写 dogapi 的 sk-xxx token
SKILL_DEFAULT_MODEL_NAME=gpt-5.4
SKILL_DEFAULT_DISPLAY_NAME=系统默认 (GPT-5.4)

# ============================================
# RAG 默认向量化模型（系统兜底，所有用户共享）
# 不配置时新用户会退到 TF-IDF 伪向量，召回质量很差
#
# 推荐：阿里云百炼 text-embedding-v4
#   - OpenAI 兼容协议，与 NEXUS 现有 EmbeddingService 100% 契合
#   - 1024 默认维度，性能/成本平衡最优
#   - 100 万 Token 免费额度（百炼开通后 90 天内）
#
# 申请 DashScope API Key：
#   https://help.aliyun.com/zh/model-studio/get-api-key
# 模型清单与定价：
#   https://help.aliyun.com/zh/model-studio/embedding
# ============================================
RAG_DEFAULT_EMBEDDING_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RAG_DEFAULT_EMBEDDING_API_KEY=请填写阿里云百炼的 sk-xxx (DashScope key)
RAG_DEFAULT_EMBEDDING_MODEL_NAME=text-embedding-v4

# ============================================
# RAG 默认 Rerank 重排模型（系统兜底，所有用户共享）
# 不配置时退化为单阶段检索（仅 embedding 召回，无重排）
#
# 推荐：阿里云百炼 gte-rerank-v2
#   - cross-encoder 架构，对 (query, doc) pair 直接打分
#   - 与 embedding 共用同一个 DashScope key（API_KEY 不填会自动读 EMBEDDING_API_KEY）
#   - 工业实践：embedding 召回 + cross-encoder 重排，最终 Top-K 准确率从 60-70% 提到 85-95%
#
# 注意：
#   - URL 是 DashScope 原生 API，不是 /compatible-mode/v1（OpenAI 没有 rerank 接口）
#   - 模型清单：https://help.aliyun.com/zh/model-studio/text-rerank
# ============================================
RAG_DEFAULT_RERANK_API_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RAG_DEFAULT_RERANK_API_KEY=
RAG_DEFAULT_RERANK_MODEL_NAME=gte-rerank-v2
